# Copy these names and placeholders into .env.local. Do not commit .env.local.
# This demo uses only a configured test phone and fictional appointment data.

CALL_TO_NUMBER=+replace_with_your_test_phone_number
TELNYX_API_KEY=replace_with_your_telnyx_api_key
TELNYX_ACCOUNT_SID=replace_with_your_telnyx_account_uuid
TELNYX_APPLICATION_SID=replace_with_your_texml_application_id
TELNYX_PHONE_NUMBER=+replace_with_your_telnyx_voice_number
TELNYX_PUBLIC_KEY=replace_with_your_telnyx_ed25519_public_key

# Keep ConversationRelay during the trial. Change only this value for rollback.
VOICE_RUNTIME=conversation-relay

# The managed runtime requires these values. Relay mode ignores them.
# VOICE_RUNTIME=telnyx-candidate
# TELNYX_CONNECTION_ID=replace_with_your_voice_api_connection_id
# TELNYX_AI_ASSISTANT_ID=replace_after_the_phase_5_approved_write
# VOICE_ASSISTANT_TOOL_SECRET=replace_with_at_least_32_random_bytes_in_base64url
# Provisioning only. Telnyx stores this key and the gateway does not read it.
# TELNYX_OPENAI_API_KEY=replace_with_your_paid_openai_api_key

# Isolated one-line voice check. See docs/voice-telnyx-setup.md.
TELNYX_PUBLIC_BASE_URL=
TELNYX_CONVERSATION_PORT=3002

VOICE_DEMO_MODE=true
VOICE_CALLS_ENABLED=true
VOICE_GATEWAY_INTERNAL_SECRET=replace_with_a_random_value_of_at_least_24_characters
VOICE_GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
VOICE_GATEWAY_PORT=3001
VOICE_GATEWAY_DEBUG_LOG_PATH=.voice-logs/voice-gateway.jsonl
# pnpm dev replaces this value in its child processes with the current ngrok URL.
VOICE_GATEWAY_PUBLIC_BASE_URL=https://replace-with-your-ngrok-domain.ngrok-free.app

VOICE_LANGUAGE=en-US
VOICE_TRANSCRIPTION_PROVIDER=deepgram
VOICE_SPEECH_MODEL=flux
VOICE_TTS_VOICE=Telnyx.NaturalHD.astra
# Premium AMD is opt-in because it can delay the first greeting.
VOICE_ANSWERING_MACHINE_DETECTION=disabled

VOICE_AI_PROVIDER=local-codex-proxy
VOICE_AI_BASE_URL=http://127.0.0.1:18765/v1
VOICE_AI_MODEL=gpt-5.6-luna-fast
VOICE_AI_REASONING_EFFORT=none
VOICE_AI_API_KEY=local-codex-proxy-placeholder
VOICE_AI_TIMEOUT_MS=5000
