# Copy this file to .voice-preflight.env. Replace every placeholder.
# Keep this file limited to the local gateway and public tunnel settings.

VOICE_GATEWAY_INTERNAL_SECRET=replace_with_the_same_random_value_used_by_the_gateway
VOICE_GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
VOICE_GATEWAY_DEBUG_LOG_PATH=.voice-logs/voice-gateway.jsonl
VOICE_RUNTIME=current-gateway
# pnpm dev replaces this value in its preflight child process with the current ngrok URL.
VOICE_GATEWAY_PUBLIC_BASE_URL=https://replace-with-your-ngrok-domain.ngrok-free.app
